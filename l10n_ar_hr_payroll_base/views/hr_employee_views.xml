<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n_ar_payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <page name="payroll_information" position="after">
                <page name="l10n_ar_payroll" string="Payroll Book" groups="hr_payroll.group_hr_payroll_user">
                    <group>
                        <group>
                            <field name="ssnid" string="CUIL"/>
                            <field name="l10n_ar_file_number"/>
                            <field name="l10n_ar_seniority_date"/>
                        </group>
                        <group>
                            <field name="l10n_ar_health_insurance_id"/>
                            <field name="l10n_ar_condition_id"/>
                            <field name="l10n_ar_activity_id"/>
                            <field name="l10n_ar_modality_id"/>
                            <field name="l10n_ar_casualty_id"/>
                            <field name="l10n_ar_zone_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Employment Status History">
                            <field name="l10n_ar_situation_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="date_from"/>
                                    <field name="situation_id"/>
                                </list>
                            </field>
                        </group>
                        <group string="Family Information">
                            <field name="l10n_ar_family_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="date_from"/>
                                    <field name="kind"/>
                                    <field name="dependent" invisible="kind != 'spouse'"/>
                                    <field name="children_count" invisible="kind != 'children'"/>
                                </list>
                            </field>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
