<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ar_payment_withholding_form" model="ir.ui.view">
        <field name="name">l10n_ar.payment.withholding.form</field>
        <field name="model">l10n_ar.payment.withholding</field>
        <field name="inherit_id" ref="l10n_ar_tax.view_l10n_ar_payment_withholding_form"/>
        <field name="arch" type="xml">
            <field name="amount" position="after">
                <field name="es_sire" invisible="1"/>
                <group invisible="not es_sire">
                    <field name="sire_aplica_cdi"/>
                    <field name="sire_aplica_acrecentamiento"/>
                    <field name="sire_codigo_alicuota" required="es_sire"/>
                </group>
            </field>
        </field>
    </record>

</odoo>
