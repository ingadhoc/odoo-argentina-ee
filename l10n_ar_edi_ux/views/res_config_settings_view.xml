<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ar_edi.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Permite vincular correctamente la clave privada con el certificado, y forzar que el certificado se cree usando el create and edit -->
            <field name="l10n_ar_afip_ws_crt_id" position="attributes">
                <attribute name="context">{'default_private_key_id': l10n_ar_afip_ws_key_id}</attribute>
                <attribute name="options">{'no_quick_create': True}</attribute>
            </field>

            <!-- TODO 20.0: drop. Backport of odoo/enterprise#102032, already shipped in
                 l10n_ar_edi 20.0. The selector supersedes l10n_ar_edi's
                 l10n_ar_show_withholding_legend checkbox, which is dropped here so that
                 the legend is configured in a single place (see res_company.py). -->
            <xpath expr="//div[field[@name='l10n_ar_show_withholding_legend']]" position="replace"/>
            <xpath expr="//block[@id='argentina_localization']" position="inside">
                <setting string="Add Legend to Invoice PDF" help="The selected legend is printed below the Document Type letter on the Invoice PDF of documents with letter A and M. Branches with no legend of their own print the one configured on the closest parent company." invisible="country_code != 'AR'">
                    <label for="l10n_ar_invoice_pdf_legend" string="Legend" class="o_light_label col-lg-3"/>
                    <field name="l10n_ar_invoice_pdf_legend"/>
                </setting>
            </xpath>

        </field>
    </record>

</odoo>
