<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TODO 20.0: MANDATORY on the update, not an optional cleanup: this template
         inherits l10n_ar_edi.custom_header_inherit and replaces the block inside it,
         both of which 20.0 removes, and that fails the module load. See res_company.py.
         Backport of odoo/enterprise#102032. It inherits l10n_ar_edi's own extension of
         l10n_ar.custom_header and replaces its block so that the legend is printed once
         whatever value is left in the boolean this selector supersedes. The xpath
         matches that block by its condition and not by position, because
         _apply_inheritance_specs() takes the first node the expression matches and a
         plain /t would replace the wrong one if another module ever inserted a t into
         the span before this view.
         The condition diverges from upstream: l10n_ar.custom_header is shared by reports
         whose record is not an account.move (l10n_ar_stock_ux delivery slip, l10n_ar_sale
         order, l10n_ar_purchase order, l10n_ar_tax payment receipt and withholding
         certificate, l10n_ar_ux internal transfer), and pre-printed stationery prints no
         document letter to hang the legend from. -->
    <template id="custom_header_inherit" inherit_id="l10n_ar_edi.custom_header_inherit">
        <xpath expr="//span[@id='withholding_legend']/t[contains(@t-if, 'l10n_ar_show_withholding_legend')]" position="replace">
            <t t-if="o._name == 'account.move' and not pre_printed_report and document_type_code in ['1', '2', '3', '51', '52', '53']">
                <t t-set="l10n_ar_pdf_legend" t-value="o.company_id._l10n_ar_get_invoice_pdf_legend_text()"/>
                <t t-if="l10n_ar_pdf_legend">
                    <br/>
                    <span class="d-block small mt-1 lh-1" t-out="l10n_ar_pdf_legend"/>
                </t>
            </t>
        </xpath>
    </template>

</odoo>
