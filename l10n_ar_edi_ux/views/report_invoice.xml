<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TODO 20.0: drop. Backport of odoo/enterprise#102032, already shipped in
         l10n_ar_edi 20.0. Extends the same node as upstream (span#withholding_legend),
         and prints both legends: the selector supersedes l10n_ar_edi's
         l10n_ar_show_withholding_legend boolean, whose value is moved into it, so its
         own block never renders (see res_company.py). The condition diverges from
         upstream because l10n_ar.custom_header is shared by reports whose record is not
         an account.move (l10n_ar_stock_ux delivery slip, l10n_ar_sale order,
         l10n_ar_purchase order, l10n_ar_tax payment receipt and withholding
         certificate, l10n_ar_ux internal transfer), and because pre-printed stationery
         prints no document letter to hang the legend from. -->
    <template id="custom_header_inherit" inherit_id="l10n_ar.custom_header">
        <xpath expr="//span[@id='withholding_legend']" position="inside">
            <t t-if="o._name == 'account.move' and not pre_printed_report and document_type_code in ['1', '2', '3', '51', '52', '53']">
                <t t-set="legend_company" t-value="o.company_id._l10n_ar_get_invoice_pdf_legend_company()"/>
                <t t-if="legend_company">
                    <br/>
                    <span class="d-block small mt-1 lh-1" t-field="legend_company.l10n_ar_invoice_pdf_legend"/>
                </t>
            </t>
        </xpath>
    </template>

</odoo>
