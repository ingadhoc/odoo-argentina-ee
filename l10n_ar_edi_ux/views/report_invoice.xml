<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pre-printed stationery prints no document letter to hang the legend from -->
    <template id="custom_header_inherit" inherit_id="l10n_ar_edi.custom_header_inherit">
        <xpath expr="//span[@id='withholding_legend']/t[contains(@t-if, 'l10n_ar_invoice_pdf_legend')]" position="attributes">
            <attribute name="t-if" separator=" and " add="not pre_printed_report"/>
        </xpath>
    </template>

</odoo>
