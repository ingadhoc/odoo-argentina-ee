<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.balance.import</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_base_import.res_config_settings_import_view_form"/>
        <field name="arch" type="xml">
            <!-- Remove help text from Initial Setup setting -->
            <xpath expr="//block[@name='accounting_import_setting_container']/setting" position="attributes">
                <attribute name="help"></attribute>
            </xpath>

            <!-- Hide original Review Manually button -->
            <xpath expr="//div[hasclass('d-flex', 'mt4', 'align-items-center')][button[@name='%(account_base_import.action_open_coa_setup)d']]" position="replace"/>

        </field>
    </record>
</odoo>
