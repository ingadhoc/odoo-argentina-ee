<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tax_settlement_reassign_form" model="ir.ui.view">
        <field name="name">l10n_ar.tax.settlement.reassign.form</field>
        <field name="model">l10n_ar.tax.settlement.reassign</field>
        <field name="arch" type="xml">
            <form string="Reassign Tax Settlement">
                <field name="line_ids" invisible="1"/>
                <field name="line_count" invisible="1"/>
                <field name="journal_ids" invisible="1"/>
                <div invisible="line_count > 1">
                    We could not tell for sure in which settlement this withholding was declared. Choose the right
                    one and confirm it before reassigning: what we suggest is the settlement left with a gap of
                    exactly that amount, which is a guess.
                </div>
                <div invisible="line_count &lt;= 1">
                    We could not tell for sure in which settlement these withholdings were declared. Choose the right
                    one and confirm it before reassigning: what we suggest is the settlement left with a gap of
                    exactly that amount, which is a guess.
                </div>
                <group>
                    <field name="settlement_move_id" options="{'no_create': True}"/>
                    <field name="candidate_move_ids" string="Settlements With A Gap" widget="many2many_tags"
                           readonly="1" invisible="not candidate_move_ids"/>
                </group>
                <footer>
                    <button name="action_reassign" string="Reassign" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
