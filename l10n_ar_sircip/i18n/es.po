#. module: l10n_ar_sircip
#: model_terms:ir.ui.view,arch_db:l10n_ar_sircip.res_config_settings_view_form_sircip
msgid ""
"Creates the SIRCIP taxes, account, fiscal position and settlement journal, "
"and adds the SIRCIP line to the fiscal positions with perceptions, also to "
"the ones created later."
msgstr ""
"Crea los impuestos, la cuenta, la posición fiscal y el diario de liquidación "
"SIRCIP, y agrega la línea SIRCIP a las posiciones fiscales con percepciones, "
"también a las que se creen después."

#. module: l10n_ar_sircip
#. odoo-python
#: code:addons/l10n_ar_sircip/models/account_journal.py:0
msgid ""
"Credit note %(move)s has no original invoice. It is mandatory in the SIRCIP "
"DDJJ."
msgstr ""
"La nota de crédito %(move)s no tiene factura original. Es obligatoria en la "
"DDJJ de SIRCIP."

