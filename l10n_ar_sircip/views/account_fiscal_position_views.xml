<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_position_form_sircip" model="ir.ui.view">
        <field name="name">account.fiscal.position.form.sircip</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not l10n_ar_sircip_warning">
                    <field name="l10n_ar_sircip_warning" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
