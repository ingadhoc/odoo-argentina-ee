<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_sircip" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sircip</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ar.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='argentina_localization']" position="inside">
                <setting id="l10n_ar_sircip_agent" string="SIRCIP Perception Agent"
                    help="Creates the SIRCIP taxes, account, fiscal position and settlement journal, and adds the SIRCIP line to the fiscal positions with perceptions, also to the ones created later.">
                    <field name="l10n_ar_sircip_agent"/>
                    <div class="content-group mt-2" invisible="not l10n_ar_sircip_agent">
                        <div class="row">
                            <label for="l10n_ar_sircip_account_id" class="col-lg-4 o_light_label"/>
                            <field name="l10n_ar_sircip_account_id" options="{'no_create': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
