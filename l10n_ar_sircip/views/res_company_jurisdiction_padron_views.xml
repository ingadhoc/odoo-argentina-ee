<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Offer the SIRCIP pseudo-province in the padron and tax autocomplete -->
    <record id="view_res_company_jurisdiction_padron_form_sircip" model="ir.ui.view">
        <field name="name">res.company.jurisdiction.padron.form.sircip</field>
        <field name="model">res.company.jurisdiction.padron</field>
        <field name="inherit_id" ref="l10n_ar_tax.view_res_company_jurisdiction_padron_form"/>
        <field name="arch" type="xml">
            <field name="state_id" position="attributes">
                <attribute name="context">{'l10n_ar_sircip_show_state': True}</attribute>
            </field>
        </field>
    </record>

    <record id="view_tax_form_sircip" model="ir.ui.view">
        <field name="name">account.tax.form.sircip</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="l10n_ar_withholding.view_tax_form-l10n_ar"/>
        <field name="arch" type="xml">
            <field name="l10n_ar_state_id" position="attributes">
                <attribute name="context">{'l10n_ar_sircip_show_state': True}</attribute>
            </field>
        </field>
    </record>

</odoo>
