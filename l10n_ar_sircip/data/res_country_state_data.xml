<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Provincia ficticia SIRCIP: identificador unívoco del padrón.
         No debe ser seleccionable por el usuario en formularios de contacto.
         Se filtra en vistas de res.partner vía domain sobre l10n_ar_is_sircip=False. -->
    <record id="state_ar_sircip" model="res.country.state">
        <field name="name">SIRCIP</field>
        <field name="code">SI</field>
        <field name="country_id" ref="base.ar"/>
    </record>

