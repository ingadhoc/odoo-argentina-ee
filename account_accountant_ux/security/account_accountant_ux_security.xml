<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lets billing users open the partner reports from the contact, without the rest of the accounting reports -->
    <record id="group_partner_report_reader" model="res.groups">
        <field name="name">Read partner ledger, customer statement and follow-up reports</field>
    </record>

    <record id="account.group_account_invoice" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_partner_report_reader'))]"/>
    </record>

    <record id="account_report_partner_report_reader_rule" model="ir.rule">
        <field name="name">Account report: partner reports only</field>
        <field name="model_id" ref="account.model_account_report"/>
        <field name="groups" eval="[(4, ref('group_partner_report_reader'))]"/>
        <field name="domain_force" eval="str([('id', 'in', [ref('account_reports.partner_ledger_report'), ref('account_reports.customer_statement_report'), ref('account_reports.followup_report')])])"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_report_line_partner_report_reader_rule" model="ir.rule">
        <field name="name">Account report line: partner reports only</field>
        <field name="model_id" ref="account.model_account_report_line"/>
        <field name="groups" eval="[(4, ref('group_partner_report_reader'))]"/>
        <field name="domain_force" eval="str([('report_id', 'in', [ref('account_reports.partner_ledger_report'), ref('account_reports.customer_statement_report'), ref('account_reports.followup_report')])])"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_report_expression_partner_report_reader_rule" model="ir.rule">
        <field name="name">Account report expression: partner reports only</field>
        <field name="model_id" ref="account.model_account_report_expression"/>
        <field name="groups" eval="[(4, ref('group_partner_report_reader'))]"/>
        <field name="domain_force" eval="str([('report_line_id.report_id', 'in', [ref('account_reports.partner_ledger_report'), ref('account_reports.customer_statement_report'), ref('account_reports.followup_report')])])"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_report_column_partner_report_reader_rule" model="ir.rule">
        <field name="name">Account report column: partner reports only</field>
        <field name="model_id" ref="account.model_account_report_column"/>
        <field name="groups" eval="[(4, ref('group_partner_report_reader'))]"/>
        <field name="domain_force" eval="str([('report_id', 'in', [ref('account_reports.partner_ledger_report'), ref('account_reports.customer_statement_report'), ref('account_reports.followup_report')])])"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Accountants also get the group above through billing; group rules are OR-ed, so this keeps every report open for them -->
    <record id="account_report_accountant_rule" model="ir.rule">
        <field name="name">Account report: all reports for accountants</field>
        <field name="model_id" ref="account.model_account_report"/>
        <field name="groups" eval="[(4, ref('account.group_account_basic')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_report_line_accountant_rule" model="ir.rule">
        <field name="name">Account report line: all reports for accountants</field>
        <field name="model_id" ref="account.model_account_report_line"/>
        <field name="groups" eval="[(4, ref('account.group_account_basic')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_report_expression_accountant_rule" model="ir.rule">
        <field name="name">Account report expression: all reports for accountants</field>
        <field name="model_id" ref="account.model_account_report_expression"/>
        <field name="groups" eval="[(4, ref('account.group_account_basic')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_report_column_accountant_rule" model="ir.rule">
        <field name="name">Account report column: all reports for accountants</field>
        <field name="model_id" ref="account.model_account_report_column"/>
        <field name="groups" eval="[(4, ref('account.group_account_basic')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
