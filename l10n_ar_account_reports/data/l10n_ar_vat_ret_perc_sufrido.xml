<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ar_iva_report" model="account.report">
        <field name="name">IVA Sufrido</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="sequence">20</field>
        <field name="country_id" ref="base.ar"/>
        <field name="filter_hierarchy">never</field>
        <field name="filter_unreconciled" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field name="custom_handler_model_id" ref="model_l10n_ar_iva_report_handler"/>
        <field name="column_ids">
            <record id="l10n_ar_iva_report_column_total" model="account.report.column">
                <field name="name">Balance</field>
                <field name="name@es_419">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <!-- TODO: ver que agregamos en el domain para retenciones iva sufridas las identificamos por tax group? -->
            <!-- <record id="l10n_ar_iva_report_iva_withholdings_line" model="account.report.line">
                <field name="name">Sale Withholdings</field>
                <field name="domain_formula">sum([("tax_line_id.l10n_ar_state_id", "=", False), ("tax_line_id.l10n_ar_withholding_payment_type", "=", "customer")])</field>
            </record> -->
            <record id="l10n_ar_iva_report_iva_perceptions_line" model="account.report.line">
                <field name="name">Purchase Perceptions</field>
                <field name="domain_formula">sum([("tax_line_id.l10n_ar_state_id", "=", False), ("tax_line_id.type_tax_use", "=", "purchase"), ("tax_line_id.tax_group_id.l10n_ar_tribute_afip_code", "=", "06")])</field>
            </record>
        </field>
    </record>

    <record id="ar_iva_iibb_return_type" model="account.return.type">
        <field name="name">IVA Sufrido (Agente)</field>
        <field name="report_id" ref="l10n_ar_account_reports.l10n_ar_iva_report"/>
        <field name="default_deadline_periodicity">monthly</field>
        <field name="auto_generate" eval="False"/>
        <field name="country_id" ref="base.ar"/>
        <field name="deadline_days_delay">10</field>
        <field name="default_deadline_days_delay">31</field>
        <field name="states_workflow">generic_state_review</field>
        <field name="payment_partner_id" ref="l10n_ar.partner_afip"/>
    </record>
</odoo>
