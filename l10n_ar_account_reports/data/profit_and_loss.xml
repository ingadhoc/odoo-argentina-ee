<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="account_financial_report_l10n_ar_pl" model="account.report">
        <field name="name">Estado de Resultados (Argentina)</field>
        <field name="root_report_id" ref="account_reports.profit_and_loss"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="country_id" ref="base.ar"/>
        <field name="filter_multi_company">selector</field>
        <field name="column_ids">
            <record id="account_financial_report_l10n_ar_pl_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <!-- Ventas netas de bienes y servicios -->
            <record id="ar_pl_line_sales" model="account.report.line">
                <field name="name">Ventas netas de bienes y servicios</field>
                <field name="code">sales</field>
                <field name="hierarchy_level">1</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_sales_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">account_tags</field>
                        <field name="formula">l10n_ar_account_reports.ar_eerr_ventas</field>
                    </record>
                </field>
            </record>
            <!-- Costo de venta de bienes y servicios -->
            <record id="ar_pl_line_cogs" model="account.report.line">
                <field name="name">Costo de venta de bienes y servicios</field>
                <field name="code">cogs</field>
                <field name="hierarchy_level">1</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_cogs_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">account_tags</field>
                        <field name="formula">l10n_ar_account_reports.ar_eerr_costo_ventas</field>
                    </record>
                </field>
            </record>
            <!-- Ganancia (Pérdida) bruta -->
            <record id="ar_pl_line_gross_inc" model="account.report.line">
                <field name="name">Ganancia (Pérdida) bruta</field>
                <field name="code">gross_inc</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_gross_inc_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">sales.balance + cogs.balance</field>
                    </record>
                </field>
            </record>
            <!-- Gastos de comercialización -->
            <record id="ar_pl_line_com_exp" model="account.report.line">
                <field name="name">Gastos de comercialización</field>
                <field name="code">com_exp</field>
                <field name="hierarchy_level">1</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_com_exp_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">account_tags</field>
                        <field name="formula">l10n_ar_account_reports.ar_eerr_gastos_comercializacion</field>
                    </record>
                </field>
            </record>
            <!-- Gastos de administración -->
            <record id="ar_pl_line_adm_exp" model="account.report.line">
                <field name="name">Gastos de administración</field>
                <field name="code">adm_exp</field>
                <field name="hierarchy_level">1</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_adm_exp_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">account_tags</field>
                        <field name="formula">l10n_ar_account_reports.ar_eerr_gastos_administracion</field>
                    </record>
                </field>
            </record>
            <!-- Otros gastos -->
            <record id="ar_pl_line_other_exp" model="account.report.line">
                <field name="name">Otros gastos</field>
                <field name="code">other_exp</field>
                <field name="hierarchy_level">1</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_other_exp_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">account_tags</field>
                        <field name="formula">l10n_ar_account_reports.ar_eerr_otros_gastos</field>
                    </record>
                </field>
            </record>
            <!-- Resultados financieros y por tenencia (incluye RECPAM) -->
            <record id="ar_pl_line_fin_exp" model="account.report.line">
                <field name="name">Resultados financieros y por tenencia (incluye RECPAM)</field>
                <field name="code">fin_exp</field>
                <field name="hierarchy_level">1</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_fin_exp_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">account_tags</field>
                        <field name="formula">l10n_ar_account_reports.ar_eerr_rxt_resultados_financieros</field>
                    </record>
                </field>
            </record>
            <!-- Otros ingresos y egresos -->
            <record id="ar_pl_line_other_inc_exp" model="account.report.line">
                <field name="name">Otros ingresos y egresos</field>
                <field name="code">other_inc_exp</field>
                <field name="hierarchy_level">1</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_other_inc_exp_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">account_tags</field>
                        <field name="formula">l10n_ar_account_reports.ar_eerr_otros_ingresos_egresos</field>
                    </record>
                </field>
            </record>
            <!-- Resultado antes del impuesto a las ganancias -->
            <record id="ar_pl_line_inc_before_tax" model="account.report.line">
                <field name="name">Resultado antes del impuesto a las ganancias</field>
                <field name="code">inc_before_tax</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_inc_before_tax_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">gross_inc.balance + com_exp.balance + adm_exp.balance + other_exp.balance + fin_exp.balance + other_inc_exp.balance</field>
                    </record>
                </field>
            </record>
            <!-- Impuesto a las ganancias -->
            <record id="ar_pl_line_tax_inc" model="account.report.line">
                <field name="name">Impuesto a las ganancias</field>
                <field name="code">tax_inc</field>
                <field name="hierarchy_level">1</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_tax_inc_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">account_tags</field>
                        <field name="formula">l10n_ar_account_reports.ar_eerr_impuesto_ganancias</field>
                    </record>
                </field>
            </record>
            <!-- Resultado Final del ejercicio -->
            <record id="ar_pl_line_net_inc" model="account.report.line">
                <field name="name">Resultado Final del ejercicio</field>
                <field name="code">net_inc</field>
                <field name="hierarchy_level">0</field>
                <field name="expression_ids">
                    <record id="ar_pl_line_net_inc_expr" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">inc_before_tax.balance + tax_inc.balance</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
