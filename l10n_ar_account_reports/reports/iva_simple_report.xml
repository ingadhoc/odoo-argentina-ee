<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporte IVA Simple -->
    <record id="iva_simple_report" model="account.report">
        <field name="name">Reporte IVA Simple</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.ar"/>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_hierarchy">never</field>
        <field name="filter_unreconciled" eval="False"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_growth_comparison" eval="False"/>
        <field name="custom_handler_model_id" ref="model_l10n_ar_iva_simple_report_handler"/>
        <field name="custom_handler_model_name">l10n_ar.iva.simple.report.handler</field>

        <field name="column_ids">
            <record id="iva_simple_report_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="iva_simple_report_line_main" model="account.report.line">
                <field name="name">Reporte IVA Simple</field>
            </record>
        </field>
    </record>
</odoo>
