<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_return_kanban_view" model="ir.ui.view">
        <field name="name">account.return.kanban.l10n_ar</field>
        <field name="model">account.return</field>
        <field name="inherit_id" ref="account_reports.account_return_kanban_view"/>
        <field name="arch" type="xml">
            <field name="show_companies" position="after">
                <field name="l10n_ar_is_simple_closing_return"/>
            </field>
            <xpath expr="//field[@name='company_ids']/.." position="before">
                <div class="row oe_stat_text px-0 text-muted" invisible="not show_companies or not l10n_ar_is_simple_closing_return">Companies in this return:</div>
            </xpath>
            <xpath expr="//field[@name='company_ids']/.." position="after">
                <div class="row oe_stat_text px-0 text-muted" invisible="context.get('in_checks_view') or not show_companies or not show_companies_mismatch_warning or not l10n_ar_is_simple_closing_return">Some of these companies are not selected in the company selector.</div>
            </xpath>
        </field>
    </record>
</odoo>
