<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_return_type_form_view" model="ir.ui.view">
        <field name="model">account.return.type</field>
        <field name="name">account.return.type.form</field>
        <field name="inherit_id" ref="account_reports.account_return_type_form_view"/>
        <field name="arch" type="xml">
            <field name="payment_partner_bank_id" position="after">
                <field name="debt_account_id" invisible="country_code != 'AR'" groups="account.group_account_readonly"/>
            </field>
        </field>
    </record>
</odoo>
