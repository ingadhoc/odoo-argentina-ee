<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal para reportes financieros argentinos -->
    <menuitem id="menu_l10n_ar_financial_reports"
        name="Reportes Financieros Argentina"
        parent="account.menu_finance_reports"
        sequence="10"/>

    <!-- Acción para el Estado de Resultados -->
    <record id="action_account_report_ar_estado_resultados" model="ir.actions.client">
        <field name="name">Estado de Resultados</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{
            'report_id': ref('l10n_ar_account_reports.account_financial_report_l10n_ar_estado_resultados')
        }"/>
    </record>

    <!-- Acción para el Estado Patrimonial -->
    <record id="action_account_report_ar_estado_patrimonial" model="ir.actions.client">
        <field name="name">Estado Patrimonial</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{
            'report_id': ref('l10n_ar_account_reports.account_financial_report_l10n_ar_estado_patrimonial')
        }"/>
    </record>

    <!-- Menús para cada reporte -->
    <menuitem id="menu_l10n_ar_estado_resultados"
        name="Estado de Resultados"
        parent="menu_l10n_ar_financial_reports"
        action="action_account_report_ar_estado_resultados"
        sequence="1"/>

    <menuitem id="menu_l10n_ar_estado_patrimonial"
        name="Estado Patrimonial"
        parent="menu_l10n_ar_financial_reports"
        action="action_account_report_ar_estado_patrimonial"
        sequence="2"/>
</odoo>
