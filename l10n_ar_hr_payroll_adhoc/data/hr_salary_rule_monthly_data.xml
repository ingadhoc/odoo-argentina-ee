        <field name="struct_id" ref="structure_monthly"/>
        <field name="name">Basic Salary</field>
        <field name="code">BASIC</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="category_rem"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = payslip._l10n_ar_daily_wage()
result_qty = payslip._l10n_ar_basic_days()</field>
    </record>
