<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sac_sac" model="hr.salary.rule">
        <field name="struct_id" ref="structure_sac"/>
        <field name="name">Thirteenth Salary (SAC)</field>
        <field name="code">SAC</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="category_sac"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">best, semester_days, worked_days = payslip._l10n_ar_sac()
result = best / 2 / semester_days
result_qty = worked_days</field>
    </record>
    <record id="rule_sac_jub" model="hr.salary.rule">
        <field name="struct_id" ref="structure_sac"/>
