<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.ARS" model="res.currency">
        <field name="active" eval="True"/>
    </record>

    <record id="demo_partner_distribuidora" model="res.partner">
        <field name="name">Distribuidora SRL - Sueldos</field>
        <field name="is_company" eval="True"/>
        <field name="l10n_ar_afip_responsibility_type_id" ref="l10n_ar.res_IVARI"/>
        <field name="l10n_latam_identification_type_id" ref="l10n_ar.it_cuit"/>
        <field name="vat">30712345671</field>
        <field name="street">Av. Pellegrini 1500</field>
        <field name="city">Rosario</field>
        <field name="zip">2000</field>
        <field name="state_id" ref="base.state_ar_s"/>
        <field name="country_id" ref="base.ar"/>
        <field name="email">administracion@distribuidora.example.com</field>
    </record>

    <record id="demo_company_distribuidora" model="res.company">
        <field name="name">Distribuidora SRL - Sueldos</field>
        <field name="partner_id" ref="demo_partner_distribuidora"/>
        <field name="currency_id" ref="base.ARS"/>
        <field name="l10n_ar_afip_start_date" eval="time.strftime('%Y-01-01')"/>
        <field name="l10n_ar_gross_income_type">local</field>
        <field name="l10n_ar_gross_income_number">901-12345678</field>
        <field name="l10n_ar_employer_type">1</field>
    </record>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin')]"/>
        <value eval="{'company_ids': [(4, ref('demo_company_distribuidora'))]}"/>
    </function>


    <function model="l10n_ar.payroll.demo" name="_load_demo"/>
</odoo>
