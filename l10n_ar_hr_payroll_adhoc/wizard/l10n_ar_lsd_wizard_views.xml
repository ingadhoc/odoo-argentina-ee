<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ar_lsd_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_ar.lsd.wizard.form</field>
        <field name="model">l10n_ar.lsd.wizard</field>
        <field name="arch" type="xml">
            <form string="Digital Payroll Book">
                <group>
                    <field name="run_ids" widget="many2many_tags"/>
                    <field name="liquidation_number"/>
                    <field name="lsd_filename" invisible="1"/>
                    <field name="lsd_file" filename="lsd_filename" invisible="not lsd_file"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate File" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ar_lsd_wizard" model="ir.actions.act_window">
        <field name="name">Digital Payroll Book</field>
        <field name="res_model">l10n_ar.lsd.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">list,form,kanban</field>
    </record>

    <record id="action_l10n_ar_register_payments" model="ir.actions.server">
        <field name="name">Register Employee Payments</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
        <field name="binding_view_types">list,form,kanban</field>
        <field name="group_ids" eval="[(4, ref('hr_payroll.group_hr_payroll_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_l10n_ar_register_payments()</field>
    </record>
</odoo>
